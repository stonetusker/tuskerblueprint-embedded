# Copy these as inventory/group variables and replace every value from an official source.
github_runner_version: required
github_runner_sha256: required
github_runner_repository: https://github.com/stonetusker-systems/tuskerblueprint-embedded

minio_image_tag: required
minio_client_url: required
minio_client_sha256: required
jenkins_image_tag: required
caddy_image_tag: required

mender_bundle_url: required
mender_bundle_sha256: required
mender_bundle_compose_relative: required
mender_artifact_url: required
mender_artifact_sha256: required
mender_cli_url: required
mender_cli_sha256: required

base_domain: required
acme_email: required
