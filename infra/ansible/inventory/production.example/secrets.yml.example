# Encrypt the real file with ansible-vault. Never commit live values.
github_runner_registration_token: replace-short-lived-token
github_release_runner_registration_token: replace-short-lived-token
vault_minio_root_user: replace
vault_minio_root_password: replace
vault_jenkins_agent_public_key: replace
vault_mender_signing_key: |
  replace-with-private-key
vault_mender_env_text: |
  replace-with-the-environment-required-by-the-selected-upstream-bundle
