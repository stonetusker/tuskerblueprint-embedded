"50" width="360" height="390" as="geometry"/></mxCell><mxCell id="arch-20" value="&lt;b&gt;Jenkins build agent&lt;/b&gt;&lt;br&gt;jenkins-agent.service (inbound, WebSocket)&lt;br&gt;node ubuntu24 · label yocto-vps8 · 1 executor&lt;br&gt;Docker · Yocto cache ~/yocto-cache" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-19"><mxGeometry x="15" y="40" width="330" height="110" as="geometry"/></mxCell><mxCell id="arch-21" value="&lt;b&gt;Jenkins release agent&lt;/b&gt;&lt;br&gt;jenkins-release-agent.service · node release-agent&lt;br&gt;label firmware-release · user release-agent (no Docker, no sudo)&lt;br&gt;signing key (0600) · mender-artifact · mc (no delete)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-19"><mxGeometry x="15" y="165" width="330" height="120" as="geometry"/></mxCell><mxCell id="arch-22" value="&lt;b&gt;qemu-kvm.service&lt;/b&gt;&lt;br&gt;KVM module, KSM, hugepages" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-19"><mxGeometry x="15" y="300" width="330" height="75" as="geometry"/></mxCell><mxCell id="arch-23" value="Build execution (Docker, ephemeral per build)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;rounded=1;arcSize=2;container=1;collapsible=0;" vertex="1" parent="arch-18"><mxGeometry x="400" y="50" width="520" height="390" as="geometry"/></mxCell><mxCell id="arch-24" value="&lt;b&gt;yocto-builder container&lt;/b&gt;&lt;br&gt;stonetusker/yocto-builder:&amp;lt;VERSION&amp;gt;&lt;br&gt;kas build --target &amp;lt;image&amp;gt; kas/&amp;lt;cfg&amp;gt;.yml:kas/source-lock.yml&lt;br&gt;BitBake · testimage (oeqa) · create-spdx&lt;br&gt;images: sensornode-image-ci / -release / -broken" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-23"><mxGeometry x="15" y="40" width="490" height="110" as="geometry"/></mxCell><mxCell id="arch-25" value="&lt;b&gt;Workspace&lt;/b&gt; (bind-mounted at /work)&lt;br&gt;build/tmp · build/tmp/deploy/images/qemuarm64" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-23"><mxGeometry x="15" y="160" width="240" height="90" as="geometry"/></mxCell><mxCell id="arch-26" value="&lt;b&gt;Local cache&lt;/b&gt;&lt;br&gt;~/yocto-cache · cache/&lt;br&gt;downloads/ · sstate/" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-23"><mxGeometry x="265" y="160" width="240" height="90" as="geometry"/></mxCell><mxCell id="arch-27" value="&lt;b&gt;artifacts/&lt;/b&gt;&lt;br&gt;deploy/ · test-reports/ (JUnit) · diagnostics/ · sbom/ · release-qemu/ · ota/&amp;lt;run&amp;gt;/ evidence · build-duration-seconds" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-23"><mxGeometry x="15" y="260" width="490" height="115" as="geometry"/></mxCell><mxCell id="arch-28" value="Jenkins controller (docker: jenkins-jenkins-1)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;rounded=1;arcSize=2;container=1;collapsible=0;" vertex="1" parent="arch-18"><mxGeometry x="1490" y="50" width="420" height="390" as="geometry"/></mxCell><mxCell id="arch-29" value="&lt;b&gt;Jenkins 2.568.3&lt;/b&gt; (tuskerblueprint/jenkins)&lt;br&gt;UI :8088 → 8080 · agents :50000&lt;br&gt;volume jenkins-home" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-28"><mxGeometry x="15" y="40" width="390" height="80" as="geometry"/></mxCell><mxCell id="arch-30" value="&lt;b&gt;Jobs&lt;/b&gt; (defined in ci/jenkins/)&lt;br&gt;• sensornode-ci · multibranch, polls Git every 5 min&lt;br&gt;• sensornode-nightly · 02:00 UTC regression + cache refresh&lt;br&gt;• sensornode-release-candidate · approval: firmware-signing-approvers&lt;br&gt;• sensornode-promote-mender · approval: firmware-production-approvers&lt;br&gt;• sensornode-diagnostic-build · failure drill, approved rebuild" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-28"><mxGeometry x="15" y="130" width="390" height="120" as="geometry"/></mxCell><mxCell id="arch-31" value="&lt;b&gt;Jenkins MCP endpoint&lt;/b&gt; (roadmap)&lt;br&gt;read-only tools: logs, JUnit, bundle&lt;br&gt;no promotion rights" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="arch-28"><mxGeometry x="15" y="260" width="390" height="110" as="geometry"/></mxCell><mxCell id="arch-32" value="MinIO object store (docker: minio-minio-1)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;rounded=1;arcSize=2;container=1;collapsible=0;" vertex="1" parent="arch-18"><mxGeometry x="940" y="50" width="530" height="390" as="geometry"/></mxCell><mxCell id="arch-33" value="&lt;b&gt;MinIO&lt;/b&gt; RELEASE.2024-08-03&lt;br&gt;S3 API :9000 · console :9001&lt;br&gt;policies: cache read/write, evidence read/write" style="rounded=1;arcSize