<mxfile host="Electron" agent="TuskerBlueprint diagram generator" version="24.7.17"><diagram id="arch" name="System Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch-1" value="&lt;b&gt;TuskerBlueprint Embedded — System Architecture&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;SensorNode: Yocto (scarthgap, qemuarm64) image built and released by Jenkins on one Ubuntu 24.04 host, cached in MinIO, validated in QEMU, signed on an isolated release agent, delivered with Mender A/B OTA after two human approvals. As of 2026-11-17.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="arch-2" value="Developer workstation (Mac M3 / Ubuntu laptop)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;rounded=1;arcSize=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="300" height="300" as="geometry"/></mxCell><mxCell id="arch-3" value="&lt;b&gt;Git working copy&lt;/b&gt;&lt;br&gt;app/sensornode (Go)&lt;br&gt;meta-sensornode (layer)&lt;br&gt;kas/*.yml, scripts/, docs/" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-2"><mxGeometry x="15" y="40" width="270" height="80" as="geometry"/></mxCell><mxCell id="arch-4" value="&lt;b&gt;Local checks&lt;/b&gt;&lt;br&gt;make app-test · app-build&lt;br&gt;make docs-check yaml-check&lt;br&gt;optional local kas build" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-2"><mxGeometry x="15" y="130" width="270" height="75" as="geometry"/></mxCell><mxCell id="arch-5" value="&lt;b&gt;Claude Code&lt;/b&gt; (assistant)&lt;br&gt;edits, runbooks, demo prep" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-2"><mxGeometry x="15" y="215" width="270" height="70" as="geometry"/></mxCell><mxCell id="arch-6" value="GitHub — Git repository only (stonetusker/tuskerblueprint-embedded)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;rounded=1;arcSize=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="820" height="300" as="geometry"/></mxCell><mxCell id="arch-7" value="&lt;b&gt;Git repository&lt;/b&gt;&lt;br&gt;main · feature branches · pull requests&lt;br&gt;CODEOWNERS · PR template · branch protection" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-6"><mxGeometry x="15" y="40" width="380" height="110" as="geometry"/></mxCell><mxCell id="arch-8" value="&lt;b&gt;GitHub runs nothing&lt;/b&gt;&lt;br&gt;no Actions workflows, runners,&lt;br&gt;environments or secrets (ADR-011)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-6"><mxGeometry x="410" y="40" width="395" height="110" as="geometry"/></mxCell><mxCell id="arch-9" value="&lt;b&gt;Review flow&lt;/b&gt;&lt;br&gt;open a pull request for code review → check the branch is green in the Jenkins &lt;i&gt;sensornode-ci&lt;/i&gt; job → merge to main.&lt;br&gt;Jenkins polls this repository; GitHub webhooks cannot reach the LAN host." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-6"><mxGeometry x="15" y="165" width="790" height="120" as="geometry"/></mxCell><mxCell id="arch-10" value="Upstream sources (pinned by kas/source-lock.yml)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#ffffff;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;rounded=1;arcSize=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="380" height="300" as="geometry"/></mxCell><mxCell id="arch-11" value="&lt;b&gt;Yocto layers&lt;/b&gt;&lt;br&gt;poky (scarthgap) · meta-openembedded&lt;br&gt;(meta-oe, networking, python)&lt;br&gt;meta-mender (core, demo, qemu)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-10"><mxGeometry x="15" y="40" width="350" height="95" as="geometry"/></mxCell><mxCell id="arch-12" value="&lt;b&gt;Source tarballs / git&lt;/b&gt; fetched by BitBake&lt;br&gt;(fallback when MinIO PREMIRRORS miss)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-10"><mxGeometry x="15" y="145" width="350" height="60" as="geometry"/></mxCell><mxCell id="arch-13" value="&lt;b&gt;Container registries&lt;/b&gt;&lt;br&gt;Jenkins, MinIO, Mender 3.8.5 images" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="arch-10"><mxGeometry x="15" y="215" width="350" height="70" as="geometry"/></mxCell><mxCell id="arch-14" value="Operator / demo laptop" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;rounded=1;arcSize=2;container=1;collapsible=0;"