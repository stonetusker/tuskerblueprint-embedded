<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="TuskerBlueprint diagram generator" version="24.7.17"><diagram id="flow" name="Commit to Device (end-to-end)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4880" pageHeight="2050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow-1" value="&lt;b&gt;TuskerBlueprint Embedded — How a code commit reaches the device&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;GitHub only hosts the code. Jenkins polls it and runs every stage: branch checks, the main-branch build, the release candidate, approved signing, approved Mender promotion, then the A/B OTA update with a health-gated commit or automatic rollback.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2600" height="60" as="geometry"/></mxCell><mxCell id="flow-2" value="Developer /&lt;br&gt;Release manager" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="4820" height="200" as="geometry"/></mxCell><mxCell id="flow-3" value="GitHub&lt;br&gt;(Git repository&lt;br&gt;only)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="4820" height="180" as="geometry"/></mxCell><mxCell id="flow-4" value="Jenkins controller&lt;br&gt;(jobs, polling,&lt;br&gt;approvals)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="4820" height="210" as="geometry"/></mxCell><mxCell id="flow-5" value="Build agent&lt;br&gt;yocto-vps8&lt;br&gt;+ yocto-builder" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="4820" height="230" as="geometry"/></mxCell><mxCell id="flow-6" value="MinIO&lt;br&gt;(cache + evidence)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="4820" height="200" as="geometry"/></mxCell><mxCell id="flow-7" value="Release agent&lt;br&gt;firmware-release&lt;br&gt;(isolated)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="1160" width="4820" height="200" as="geometry"/></mxCell><mxCell id="flow-8" value="Mender server&lt;br&gt;(docker.mender.io)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="1360" width="4820" height="200" as="geometry"/></mxCell><mxCell id="flow-9" value="QEMU device&lt;br&gt;sensornode-canary-01" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#b1ddf0;strokeColor=#10739e;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="1560" width="4820" height="370" as="geometry"/></mxCell><mxCell id="flow-10" value="&lt;b&gt;A · Develop&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="190" y="85" width="340" height="40" as="geometry"/></mxCell><mxCell id="flow-11" value="&lt;b&gt;B · Branch checks + review&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="85" width="350" height="40" as="geometry"/></mxCell><mxCell id="flow-12" value="&lt;b&gt;C · Merge + main CI (Jenkins polls main)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="85" width="1090" height="40" as="geometry"/></mxCell><mxCell id="flow-13" value="&lt;b&gt;D · Release candidate (manual)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2060" y="85" width="730" height="40" as="geometry"/></mxCell><mxCell id="flow-14" value="&lt;b&gt;E · Approve, sign, publish&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2820" y="85" width="360" height="40" as="geometry"/></mxCell><mxCell id="flow-15" value="&lt;b&gt;F · Approve + promote&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="3210" y="85" width="360" height="40" as="geometry"/></mxCell><mxCell id="flow-16" value="&lt;b&gt;G · OTA on device&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="3600" y="85" width="1230" height="40" as="geometry"/></mxCell><mxCell id="flow-17" value="&lt;b&gt;① Develop&lt;/b&gt;&lt;br&gt;Change app/sensornode (Go), meta-sensornode recipes, kas/*.yml or scripts.&lt;br&gt;Local: make app-test · app-build · docs-check; optional local kas build." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="flow-2"><mxGeometry x="170" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-18" value="&lt;b&gt;② Push a branch, open a pull request&lt;/b&gt;&lt;br&gt;The PR is for code review only (PR template, CODEOWNERS).&lt;br&gt;GitHub runs no checks." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="flow-2"><mxGeometry x="540" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-19" value="&lt;b&gt;③ Branch + pull request in GitHub&lt;/b&gt;&lt;br&gt;Stores the code and the review conversation. No Actions, runners or secrets." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="flow-3"><mxGeometry x="540" y="30.0" width="330" height="120" as="geometry"/></mxCell><mxCell id="flow-20" value="&lt;b&gt;④ sensornode-ci finds the branch&lt;/b&gt; (polls Git every 5 min)&lt;br&gt;branch job on yocto-vps8:&lt;br&gt;• make app-test app-build&lt;br&gt;• make docs-check python-check yaml-check shell-check pipeline-check policy-check" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="flow-4"><mxGeometry x="540" y="20.0" width="330" height="170" as="geometry"/></mxCell><mxCell id="flow-21" value="&lt;b&gt;⑤ Optional branch Yocto build&lt;/b&gt; (Build with Parameters → YOCTO_BUILD)&lt;br&gt;sensornode-image-ci + run-qemu-tests.sh&lt;br&gt;isolated cache ~/yocto-branch-cache/&amp;lt;branch&amp;gt;&lt;br&gt;never published to MinIO" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="flow-5"><mxGeometry x="540" y="30.0" width="330" height="170" as="geometry"/></mxCell><mxCell id="flow-22" value="&lt;b&gt;⑥ Review, check Jenkins, merge&lt;/b&gt;&lt;br&gt;Reviewer confirms the branch job is green in sensornode-ci, then merges.&lt;br&gt;Merge commit = the SHA that may later be released." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="flow-2"><mxGeometry x="920" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-23" value="&lt;b&gt;⑦ main updated&lt;/b&gt;&lt;br&gt;New commit on main; Jenkins sees it on its next poll." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="flow-3"><mxGeometry x="920" y="30.0" width="330" height="120" as="geometry"/></mxCell><mxCell id="flow-24" value="&lt;b&gt;⑧ sensornode-ci » main&lt;/b&gt; starts&lt;br&gt;one executor on the build agent, so full builds never overlap.&lt;br&gt;Also: sensornode-nightly at 02:00 UTC (clean build/tmp, rebuild, QEMU test, cache refresh)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="flow-4"><mxGeometry x="920" y="20.0" width="330" height="170" as="geometry"/></mxCell><mxCell id="flow-25" value="&lt;b&gt;⑨ Checks + cache health&lt;/b&gt;&lt;br&gt;same checks as every branch&lt;br&gt;curl MinIO /minio/health/live&lt;br&gt;GIT_COMMIT = 7-character commit for the image version" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="flow-5"><mxGeometry x="920" y="30.0" width="330" height="170" as="geometry"/></mxCell><mxCell id="flow-26" value="&lt;b&gt;⑩ scripts/build-image.sh&lt;/b&gt;&lt;br&gt;prepare-build.sh → docker run stonetusker/yocto-builder&lt;br&gt;kas build --target sensornode-image-ci&lt;br&gt;kas/ci.yml (base + mender) : kas/source-lock.yml&lt;br&gt;qemuarm64 · scarthgap · version 0.3.0-&amp;lt;build#&amp;gt;-&amp;lt;sha&amp;gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="flow-5"><mxGeometry x="1280" y="30.0" width="330" height="170" as="geometry"/></mxCell><mxCell id="flow-27" value="&lt;b&gt;⑪ Cache read during BitBake&lt;/b&gt;&lt;br&gt;SSTATE_MIRRORS → yocto-sstate&lt;br&gt;PREMIRRORS → yocto-downloads&lt;br&gt;http://host.docker.internal:9000 (miss → upstream fetch)&lt;br&gt;warm build ≈ 2–4 min vs hours cold" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="flow-6"><mxGeometry x="1280" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-28" value="&lt;b&gt;⑫ QEMU test + collect outputs&lt;/b&gt;&lt;br&gt;run-qemu-tests.sh (oeqa testimage → JUnit)&lt;br&gt;collect-build-outputs.sh, collect-build-metadata.sh&lt;br&gt;Jenkins archives deploy/ and test reports" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="flow-5"><mxGeometry x="1640" y="30.0" width="330" height="170" as="geometry"/></mxCell><mxCell id="flow-29" value="&lt;b&gt;⑬ cache-sync.sh push&lt;/b&gt; (main only)&lt;br&gt;mc mirror cache/downloads → yocto-downloads&lt;br&gt;mc mirror cache/sstate → yocto-sstate&lt;br&gt;CACHE_WRITE_ALLOWED=1 only on main, nightly and release" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="flow-6"><mxGeometry x="1640" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-30" value="&lt;b&gt;Diagnostic path · sensornode-diagnostic-build&lt;/b&gt;&lt;br&gt;same scripts; FAILURE_DRILL builds the broken image, QEMU test fails, evidence bundle archived, human approves one rebuild. Cannot sign or deploy." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="flow-4"><mxGeometry x="1460" y="30.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-31" value="&lt;b&gt;⑭ Start the release&lt;/b&gt;&lt;br&gt;sensornode-release-candidate → Build with Parameters&lt;br&gt;VERSION (semver) + full 40-char SOURCE_COMMIT already on main" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="flow-2"><mxGeometry x="2040" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-32" value="&lt;b&gt;⑮ sensornode-release-candidate&lt;/b&gt;&lt;br&gt;one release at a time (disableConcurrentBuilds)&lt;br&gt;build stages on yocto-vps8 → approval → signing on firmware-release" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="flow-4"><mxGeometry x="2040" y="30.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-33" value="&lt;b&gt;⑯ Build the release&lt;/b&gt;&lt;br&gt;validate inputs · git merge-base --is-ancestor commit origin/main&lt;br&gt;validate_source_lock.py --require-mender&lt;br&gt;build kas/release.yml → sensornode-image-release (+ create-spdx)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="flow-5"><mxGeometry x="2040" y="30.0" width="330" height="170" as="geometry"/></mxCell><mxCell id="flow-34" value="&lt;b&gt;⑰ Test the exact release disk&lt;/b&gt;&lt;br&gt;run-release-qemu-tests.sh (UEFI + GRUB, pytest: health, version, sensor)&lt;br&gt;generate-sbom.sh (SPDX from the same build)&lt;br&gt;unsigned-candidate.mender + sha256 → stash + archive" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="flow-5"><mxGeometry x="2400" y="30.0" width="330" height="170" as="geometry"/></mxCell><mxCell id="flow-35" value="&lt;b&gt;⑱ Release sstate pushed&lt;/b&gt;&lt;br&gt;cache-sync.sh push" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="flow-6"><mxGeometry x="2400" y="45.0" width="330" height="110" as="geometry"/></mxCell><mxCell id="flow-36" value="&lt;b&gt;⑲ Approve signing&lt;/b&gt;&lt;br&gt;input step · submitter firmware-signing-approvers&lt;br&gt;holds no executor while waiting" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="flow-4"><mxGeometry x="2800" y="40.0" width="330" height="130" as="geometry"/></mxCell><mxCell id="flow-37" value="&lt;b&gt;⑳ Sign on the release agent&lt;/b&gt;&lt;br&gt;unstash candidate · isolated publish set&lt;br&gt;sign-artifact.sh (mender-artifact sign, key 0600)&lt;br&gt;mender-artifact validate with the public key&lt;br&gt;no Docker, no Yocto cache" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="flow-7"><mxGeometry x="2800" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-38" value="&lt;b&gt;㉑ publish_candidate.py&lt;/b&gt;&lt;br&gt;minio://release-evidence/&amp;lt;ver&amp;gt;/&amp;lt;sha&amp;gt;/&lt;br&gt;signed .mender · sha256 · manifest · sbom/ · release-qemu/&lt;br&gt;fails if the namespace exists (write-once)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="flow-6"><mxGeometry x="2800" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-39" value="&lt;b&gt;㉒ Start the promotion&lt;/b&gt;&lt;br&gt;sensornode-promote-mender → Build with Parameters&lt;br&gt;CANDIDATE_URI · EXPECTED_SHA256 · ARTIFACT_NAME · CANARY_DEVICE_IDS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="flow-2"><mxGeometry x="3190" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-40" value="&lt;b&gt;㉓ Approve canary deployment&lt;/b&gt;&lt;br&gt;input step · submitter firmware-production-approvers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="flow-4"><mxGeometry x="3190" y="45.0" width="330" height="120" as="geometry"/></mxCell><mxCell id="flow-41" value="&lt;b&gt;㉔ Promote&lt;/b&gt;&lt;br&gt;fetch_candidate.py (verify SHA-256)&lt;br&gt;upload-mender-artifact.sh → management API&lt;br&gt;create-mender-deployment.sh → &lt;b&gt;canary only&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="flow-7"><mxGeometry x="3190" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-42" value="&lt;b&gt;㉕ Artifact + deployment in Mender&lt;/b&gt;&lt;br&gt;deployments service stores the artifact (S3);&lt;br&gt;Release sensornode-&amp;lt;ver&amp;gt;-&amp;lt;build&amp;gt;-&amp;lt;sha&amp;gt;;&lt;br&gt;deployment targets the canary device IDs;&lt;br&gt;stays &lt;i&gt;Queued to start&lt;/i&gt; until that device polls" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="flow-8"><mxGeometry x="3190" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-43" value="&lt;b&gt;Demo path today&lt;/b&gt;: mender/demo-scenarios/run-ota-e2e.sh&lt;br&gt;logs in (useradm), accepts the device auth set,&lt;br&gt;uploads 102 (good) / 103-broken .mender, creates deployments,&lt;br&gt;waits for status, saves evidence to artifacts/ota/&amp;lt;run&amp;gt;/" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="flow-8"><mxGeometry x="3560" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-44" value="&lt;b&gt;㉖ Device picks up the deployment&lt;/b&gt;&lt;br&gt;mender client polls https://docker.mender.io&lt;br&gt;(QEMU slirp 10.0.2.2 → host :443)&lt;br&gt;download → verify (ArtifactVerifyKey: roadmap)&lt;br&gt;write image to &lt;b&gt;inactive rootfs B&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#10739e;strokeWidth=2;" vertex="1" parent="flow-9"><mxGeometry x="3580" y="30" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-45" value="&lt;b&gt;㉗ Switch + reboot&lt;/b&gt;&lt;br&gt;mark B as next boot (GRUB env)&lt;br&gt;reboot: UEFI → GRUB → kernel → systemd on B&lt;br&gt;sensornode.service starts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#10739e;strokeWidth=2;" vertex="1" parent="flow-9"><mxGeometry x="3940" y="30" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-46" value="&lt;b&gt;㉘ Health gate&lt;/b&gt;&lt;br&gt;ArtifactCommit_Enter_50&lt;br&gt;_sensornode-health&lt;br&gt;service active?&lt;br&gt;/health 200?&lt;br&gt;no failed units?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="flow-9"><mxGeometry x="4310" y="15" width="220" height="180" as="geometry"/></mxCell><mxCell id="flow-47" value="&lt;b&gt;㉙a PASS → commit B&lt;/b&gt;&lt;br&gt;B becomes permanent;&lt;br&gt;report success.&lt;br&gt;/version shows new image_version." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="flow-9"><mxGeometry x="4570" y="50" width="210" height="110" as="geometry"/></mxCell><mxCell id="flow-48" value="&lt;b&gt;㉙b FAIL → rollback&lt;/b&gt;&lt;br&gt;no commit; Mender reboots to rootfs A,&lt;br&gt;reports failure; device keeps serving&lt;br&gt;the last good version." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="flow-9"><mxGeometry x="4270" y="230" width="300" height="110" as="geometry"/></mxCell><mxCell id="flow-49" value="&lt;b&gt;㉛ Evidence&lt;/b&gt;&lt;br&gt;artifacts/ota/&amp;lt;run&amp;gt;/summary.json, API responses, device logs, serial.log, SHA256SUMS → docs/15-evidence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="flow-8"><mxGeometry x="3940" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-50" value="&lt;b&gt;㉚ Deployment result&lt;/b&gt;&lt;br&gt;success → separate decision to widen&lt;br&gt;canary → pilot → fleet (roadmap)&lt;br&gt;failure → stop rollout, keep evidence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="flow-8"><mxGeometry x="4330" y="25.0" width="330" height="150" as="geometry"/></mxCell><mxCell id="flow-51" value="git push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-17" target="flow-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-52" value="push branch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-18" target="flow-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-53" value="polled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-19" target="flow-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-54" value="YOCTO_BUILD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="flow-20" target="flow-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-55" value="branch green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-20" target="flow-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-56" value="merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-22" target="flow-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-57" value="polled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-23" target="flow-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-58" value="agent yocto-vps8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-24" target="flow-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-59" value="" style="edgeStyle=ortho