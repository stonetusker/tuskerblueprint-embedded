  </diagram>
  <diagram id="ota" name="OTA A/B update + rollback">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ota-1" value="&lt;b&gt;Device-side OTA: Mender A/B update with SensorNode health gate&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:12px&#39;&gt;meta-mender (mender-full) on qemuarm64 · /dev/vda · UEFI + GRUB · state script ArtifactCommit_Enter_50_sensornode-health (meta-sensornode/dynamic-layers/mender)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ota-2" value="&lt;b&gt;Idle on rootfs A&lt;/b&gt;&lt;br&gt;committed, healthy&lt;br&gt;e.g. 0.3.0-101 (factory)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-3" value="&lt;b&gt;Poll server&lt;/b&gt;&lt;br&gt;GET /api/devices/v1/deployments/&lt;br&gt;device/deployments/next" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-4" value="&lt;b&gt;Download&lt;/b&gt;&lt;br&gt;stream .mender artifact&lt;br&gt;(deployments S3 URL)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-5" value="&lt;b&gt;Verify&lt;/b&gt;&lt;br&gt;device_type qemuarm64 compatible&lt;br&gt;signature (ArtifactVerifyKey — roadmap)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-6" value="&lt;b&gt;Install to inactive slot&lt;/b&gt;&lt;br&gt;write rootfs B on /dev/vda" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-7" value="&lt;b&gt;Mark B for next boot&lt;/b&gt;&lt;br&gt;GRUB env: upgrade_available=1,&lt;br&gt;mender_boot_part=B" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="290" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-8" value="&lt;b&gt;Reboot&lt;/b&gt;&lt;br&gt;UEFI → GRUB → kernel → systemd (B)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="290" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-9" value="&lt;b&gt;ArtifactCommit_Enter&lt;/b&gt;&lt;br&gt;run state scripts on B" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="290" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-10" value="&lt;b&gt;sensornode-health&lt;/b&gt;&lt;br&gt;1. systemctl is-active sensornode&lt;br&gt;2. curl :8080/health (5 s)&lt;br&gt;3. systemctl --failed empty" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ota-11" value="&lt;b&gt;Commit B&lt;/b&gt;&lt;br&gt;upgrade_available=0&lt;br&gt;B is now active slot&lt;br&gt;e.g. 0.3.0-102" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-12" value="&lt;b&gt;Report success&lt;/b&gt;&lt;br&gt;deployment status: success&lt;br&gt;inventory updated" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-13" value="&lt;b&gt;ArtifactRollback&lt;/b&gt;&lt;br&gt;no commit; restore boot to A" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="470" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-14" value="&lt;b&gt;Reboot to A&lt;/b&gt;&lt;br&gt;last known good version" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="470" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-15" value="&lt;b&gt;Report failure&lt;/b&gt;&lt;br&gt;deployment status: failure&lt;br&gt;rollout stops (no wider deployment)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="470" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ota-16" value="&lt;b&gt;Boot-level safety net&lt;/b&gt;&lt;br&gt;If B never reaches userspace (kernel panic, hang), GRUB sees upgrade_available=1 with bootcount exhausted and falls back to A — same rollback path." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ota-17" value="&lt;b&gt;Why the broken demo release is caught&lt;/b&gt;&lt;br&gt;sensornode-image-release-broken sets SENSORNODE_FAILURE_MODE so /health returns 503. The image boots fine — only the application-level health gate refuses the commit, and the device heals itself (proven EVID-004, rollback ≈ 4–5 min)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="620" width="770" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ota-18" value="timer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-2" target="ota-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ota-19" value="deployment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-3" target="ota-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ota-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-4" target="ota-5">
          <mxGeometry relative="1" as="geometry" />
