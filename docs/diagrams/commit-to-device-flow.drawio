low-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-65" value="Build with Parameters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-31" target="flow-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-66" value="yocto-vps8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-32" target="flow-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-33" target="flow-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-34" target="flow-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-69" value="stash candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-34" target="flow-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-70" value="approved →\nfirmware-release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-36" target="flow-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-71" value="signed candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-37" target="flow-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-72" value="candidate URI + sha256" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-38" target="flow-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-73" value="Build with Parameters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-39" target="flow-40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-74" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-40" target="flow-41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-75" value="fetch exact object" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-38" target="flow-41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-76" value="Mender management API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-41" target="flow-42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-77" value="demo shortcut" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-43" target="flow-42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-78" value="deployment pending\nfor canary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-42" target="flow-44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-44" target="flow-45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-45" target="flow-46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-81" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-46" target="flow-47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-82" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-46" target="flow-48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-83" value="status: success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-47" target="flow-50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-84" value="status: failure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.05;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-48" target="flow-50"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4305" y="1505"/></Array></mxGeometry></mxCell><mxCell id="flow-85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-50" target="flow-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-86" value="&lt;b&gt;Gates that stop a bad change&lt;/b&gt;&lt;br&gt;B: unit tests, spec/YAML/shell/pipeline-policy checks on every branch · C: Yocto build + QEMU tests must pass on main · D: commit must be on main, source lock pinned, exact release disk must pass QEMU tests · E: firmware-signing-approvers, isolated key on the release agent, write-once publication · F: firmware-production-approvers, SHA-256 match, canary only · G: on-device health gate with automatic A/B rollback · the Jenkins FAILURE_DRILL proves a broken image is stopped in CI." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1950" width="3200" height="70" as="geometry"/></mxCell><mxCell id="flow-87" value="&lt;b&gt;Status (2026-11-17)&lt;/b&gt;: every stage ①–㉕ runs in Jenkins. main CI and the nightly are green; a release candidate was signed on the firmware-release agent, published write-once and promoted to a canary deployment. OTA ㉖–㉛ proven (EVID-003/004); the live demo still uploads its 102/103 artifacts with run-ota-e2e.sh. Open: devices do not enforce ArtifactVerifyKey yet; MCP/Claude diagnostics are roadmap." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="3240" y="1950" width="1600" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ota" name="OTA A/B update + rollback"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ota-1" value="&lt;b&gt;Device-side OTA: Mender A/B update with SensorNode health gate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;meta-mender (mender-full) on qemuarm64 · /dev/vda · UEFI + GRUB · state script ArtifactCommit_Enter_50_sensornode-health (meta-sensornode/dynamic-layers/mender)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="ota-2" value="&lt;b&gt;Idle on rootfs A&lt;/b&gt;&lt;br&gt;committed, healthy&lt;br&gt;e.g. 0.3.0-101 (factory)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-3" value="&lt;b&gt;Poll server&lt;/b&gt;&lt;br&gt;GET /api/devices/v1/deployments/&lt;br&gt;device/deployments/next" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-4" value="&lt;b&gt;Download&lt;/b&gt;&lt;br&gt;stream .mender artifact&lt;br&gt;(deployments S3 URL)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="120" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-5" value="&lt;b&gt;Verify&lt;/b&gt;&lt;br&gt;device_type qemuarm64 compatible&lt;br&gt;signature (ArtifactVerifyKey — roadmap)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-6" value="&lt;b&gt;Install to inactive slot&lt;/b&gt;&lt;br&gt;write rootfs B on /dev/vda" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-7" value="&lt;b&gt;Mark B for next boot&lt;/b&gt;&lt;br&gt;GRUB env: upgrade_available=1,&lt;br&gt;mender_boot_part=B" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="290" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-8" value="&lt;b&gt;Reboot&lt;/b&gt;&lt;br&gt;UEFI → GRUB → kernel → systemd (B)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="290" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-9" value="&lt;b&gt;ArtifactCommit_Enter&lt;/b&gt;&lt;br&gt;run state scripts on B" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="290" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-10" value="&lt;b&gt;sensornode-health&lt;/b&gt;&lt;br&gt;1. systemctl is-active sensornode&lt;br&gt;2. curl :8080/health (5 s)&lt;br&gt;3. systemctl --failed empty" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="260" height="150" as="geometry"/></mxCell><mxCell id="ota-11" value="&lt;b&gt;Commit B&lt;/b&gt;&lt;br&gt;upgrade_available=0&lt;br&gt;B is now active slot&lt;br&gt;e.g. 0.3.0-102" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="470" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-12" value="&lt;b&gt;Report success&lt;/b&gt;&lt;br&gt;deployment status: success&lt;br&gt;inventory updated" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-13" value="&lt;b&gt;ArtifactRollback&lt;/b&gt;&lt;br&gt;no commit; restore boot to A" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-14" value="&lt;b&gt;Reboot to A&lt;/b&gt;&lt;br&gt;last known good version" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="470" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-15" value="&lt;b&gt;Report failure&lt;/b&gt;&lt;br&gt;deployment status: failure&lt;br&gt;rollout stops (no wider deployment)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="470" width="230" height="90" as="geometry"/></mxCell><mxCell id="ota-16" value="&lt;b&gt;Boot-level safety net&lt;/b&gt;&lt;br&gt;If B never reaches userspace (kernel panic, hang), GRUB sees upgrade_available=1 with bootcount exhausted and falls back to A — same rollback path." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="560" height="80" as="geometry"/></mxCell><mxCell id="ota-17" value="&lt;b&gt;Why the broken demo release is caught&lt;/b&gt;&lt;br&gt;sensornode-image-release-broken sets SENSORNODE_FAILURE_MODE so /health returns 503. The image boots fine — only the application-level health gate refuses the commit, and the device heals itself (proven EVID-004, rollback ≈ 4–5 min)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="620" width="770" height="80" as="geometry"/></mxCell><mxCell id="ota-18" value="timer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-2" target="ota-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-19" value="deployment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-3" target="ota-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-4" target="ota-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-21" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-5" target="ota-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-6" target="ota-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-7" target="ota-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-24" value="boot B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-8" target="ota-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-9" target="ota-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-26" value="nothing pending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ota-3" target="ota-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="435" y="100"/><mxPoint x="155" y="100"/></Array></mxGeometry></mxCell><mxCell id="ota-27" value="verify fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ota-5" target="ota-15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="100"/><mxPoint x="1440" y="100"/><mxPoint x="1440" y="515"/></Array></mxGeometry></mxCell><mxCell id="ota-28" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-10" target="ota-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-11" target="ota-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-30" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ota-10" target="ota-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="335"/><mxPoint x="580" y="440"/><mxPoint x="715" y="440"/></Array></mxGeometry></mxCell><mxCell id="ota-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-13" target="ota-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-14" target="ota-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ota-33" value="now idle on B (roles swap)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ota-12" target="ota-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="515"/><mxPoint x="20" y="165"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="jenk" name="Jenkins diagnostic + AI approval"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="590" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="jenk-1" value="&lt;b&gt;Jenkins diagnostic pipeline and human-approved AI loop&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;ci/jenkins/Jenkinsfile · job sensornode-diagnostic-build · agent label yocto-vps8 · This job cannot sign or deploy; releases go only through the separately approved release jobs.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="jenk-2" value="&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;SOURCE_COMMIT (branch / sha)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="210" height="80" as="geometry"/></mxCell><mxCell id="jenk-3" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;make docs-check app-test&lt;br&gt;python-check shell-check" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="290" y="130" width="210" height="80" as="geometry"/></mxCell><mxCell id="jenk-4" value="&lt;b&gt;Build and QEMU Test&lt;/b&gt;&lt;br&gt;IMAGE = sensornode-image-ci&lt;br&gt;(FAILURE_DRILL → -broken)&lt;br&gt;build-image.sh · run-qemu-tests.sh" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="250" height="100" as="geometry"/></mxCell><mxCell id="jenk-5" value="&lt;b&gt;Diagnostic Evidence&lt;/b&gt;&lt;br&gt;create-diagnostic-bundle.sh&lt;br&gt;redact_build_logs.py · archive&lt;br&gt;JUnit (oeqa-junit.xml)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="250" height="100" as="geometry"/></mxCell><mxCell id="jenk-6" value="Result?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1120" y="125" width="120" height="90" as="geometry"/></mxCell><mxCell id="jenk-7" value="&lt;b&gt;SUCCESS&lt;/b&gt;&lt;br&gt;green build, tests published" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="130" width="200" height="80" as="geometry"/></mxCell><mxCell id="jenk-8" value="&lt;b&gt;MCP read-only tools&lt;/b&gt; (roadmap)&lt;br&gt;get logs, JUnit, bundle, build properties" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1100" y="290" width="260" height="90" as="geometry"/></mxCell><mxCell id="jenk-9" value="&lt;b&gt;Claude&lt;/b&gt; (roadmap)&lt;br&gt;classify failure, cite evidence,&lt;br&gt;propose fix / REBUILD_COMMIT&lt;br&gt;(docs/10-ai-governance format)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="760" y="290" width="280" height="90" as="geometry"/></mxCell><mxCell id="jenk-10" value="&lt;b&gt;Human Approval for Rebuild&lt;/b&gt;&lt;br&gt;input step · submitter embedded-release-approvers&lt;br&gt;only when DIAGNOSTIC_REBUILD=true" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="290" width="300" height="90" as="geometry"/></mxCell><mxCell id="jenk-11" value="&lt;b&gt;Approved Rebuild&lt;/b&gt;&lt;br&gt;optional checkout REBUILD_COMMIT&lt;br&gt;always IMAGE=sensornode-image-ci&lt;br&gt;build + QEMU test → SUCCESS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="300" height="90" as="geometry"/></mxCell><mxCell id="jenk-12" value="&lt;b&gt;Hard boundaries&lt;/b&gt;&lt;br&gt;• AI is advisory, least-privileged, cannot approve or promote&lt;br&gt;• one controlled rebuild per approval&lt;br&gt;• this job never uploads to Mender or writes release-evidence&lt;br&gt;• post: always bundle + archive evidence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="600" height="110" as="geometry"/></mxCell><mxCell id="jenk-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-2" target="jenk-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jenk-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-3" target="jenk-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jenk-15" value="pass or fail&lt;br&gt;(caught)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-4" target="jenk-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jenk-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-5" target="jenk-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jenk-17" value="SUCCESS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-6" target="jenk-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jenk-18" value="FAILURE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-6" target="jenk-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jenk-19" value="evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="jenk-8" target="jenk-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jenk-20" value="proposal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="jenk-9" target="jenk-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jenk-21" value="Approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-10" target="jenk-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jenk-22" value="re-collect evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="jenk-11" target="jenk-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="420"/><mxPoint x="720" y="420"/><mxPoint x="720" y="250"/><mxPoint x="955" y="250"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
