        <mxCell id="jenk-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-5" target="jenk-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jenk-17" value="SUCCESS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-6" target="jenk-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jenk-18" value="FAILURE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-6" target="jenk-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jenk-19" value="evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="jenk-8" target="jenk-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jenk-20" value="proposal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="jenk-9" target="jenk-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jenk-21" value="Approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-10" target="jenk-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jenk-22" value="re-collect evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="jenk-11" target="jenk-5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="420" />
              <mxPoint x="720" y="420" />
              <mxPoint x="720" y="250" />
              <mxPoint x="955" y="250" />
