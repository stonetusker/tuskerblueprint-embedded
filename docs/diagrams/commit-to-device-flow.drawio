        <mxCell id="ota-21" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ota-5" target="ota-6">
