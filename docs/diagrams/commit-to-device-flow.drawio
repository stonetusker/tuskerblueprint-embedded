  <diagram id="jenk" name="Jenkins diagnostic + AI approval">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="590" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="jenk-1" value="&lt;b&gt;Jenkins diagnostic pipeline and human-approved AI loop&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:12px&#39;&gt;ci/jenkins/Jenkinsfile · job sensornode-diagnostic-build · agent label yocto-vps8 · Jenkins is a parallel diagnostic path; GitHub Actions remains authoritative and only it can release.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="jenk-2" value="&lt;b&gt;Checkout&lt;/b&gt;&lt;br&gt;SOURCE_COMMIT (branch / sha)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="jenk-3" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;make docs-check app-test&lt;br&gt;python-check shell-check" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="130" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="jenk-4" value="&lt;b&gt;Build and QEMU Test&lt;/b&gt;&lt;br&gt;IMAGE = sensornode-image-ci&lt;br&gt;(FAILURE_DRILL → -broken)&lt;br&gt;build-image.sh · run-qemu-tests.sh" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="jenk-5" value="&lt;b&gt;Diagnostic Evidence&lt;/b&gt;&lt;br&gt;create-diagnostic-bundle.sh&lt;br&gt;redact_build_logs.py · archive&lt;br&gt;JUnit (oeqa-junit.xml)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="120" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="jenk-6" value="Result?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1120" y="125" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="jenk-7" value="&lt;b&gt;SUCCESS&lt;/b&gt;&lt;br&gt;green build, tests published" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1290" y="130" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="jenk-8" value="&lt;b&gt;MCP read-only tools&lt;/b&gt; (roadmap)&lt;br&gt;get logs, JUnit, bundle, build properties" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="1100" y="290" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="jenk-9" value="&lt;b&gt;Claude&lt;/b&gt; (roadmap)&lt;br&gt;classify failure, cite evidence,&lt;br&gt;propose fix / REBUILD_COMMIT&lt;br&gt;(docs/10-ai-governance format)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="760" y="290" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="jenk-10" value="&lt;b&gt;Human Approval for Rebuild&lt;/b&gt;&lt;br&gt;input step · submitter embedded-release-approvers&lt;br&gt;only when DIAGNOSTIC_REBUILD=true" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="290" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="jenk-11" value="&lt;b&gt;Approved Rebuild&lt;/b&gt;&lt;br&gt;optional checkout REBUILD_COMMIT&lt;br&gt;always IMAGE=sensornode-image-ci&lt;br&gt;build + QEMU test → SUCCESS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="jenk-12" value="&lt;b&gt;Hard boundaries&lt;/b&gt;&lt;br&gt;• AI is advisory, least-privileged, cannot approve or promote&lt;br&gt;• one controlled rebuild per approval&lt;br&gt;• Jenkins never uploads to Mender or writes release-evidence&lt;br&gt;• post: always bundle + archive evidence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="jenk-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-2" target="jenk-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jenk-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-3" target="jenk-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jenk-15" value="pass or fail&lt;br&gt;(caught)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jenk-4" target="jenk-5">
          <mxGeometry relative="1" as="geometry" />
