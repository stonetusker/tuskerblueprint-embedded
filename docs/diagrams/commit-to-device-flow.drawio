<mxfile host="Electron" agent="TuskerBlueprint diagram generator" pages="3">
  <diagram id="flow" name="Commit to Device (end-to-end)">
    <mxGraphModel dx="4843" dy="2557" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4880" pageHeight="2060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="flow-1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;" value="&lt;b&gt;TuskerBlueprint Embedded — How a code commit reaches the device&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:12px&#39;&gt;Numbered steps follow one change from a developer commit through PR gating, main-branch CI, release-candidate build/test/sign, Mender promotion and the A/B OTA update with health-gated commit or automatic rollback.&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="2400" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="flow-2" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" value="Developer /&lt;br&gt;Release manager" vertex="1">
          <mxGeometry height="200" width="4820" x="20" y="140" as="geometry" />
        </mxCell>
        <mxCell id="flow-17" parent="flow-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;① Develop&lt;/b&gt;&lt;br&gt;Change app/sensornode (Go), meta-sensornode recipes, kas/*.yml or scripts.&lt;br&gt;Local: make app-test · app-build · docs-check; optional local kas build." vertex="1">
          <mxGeometry height="150" width="330" x="170" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-18" parent="flow-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;② Commit + push branch, open PR → main&lt;/b&gt;&lt;br&gt;PR template, CODEOWNERS review requested.&lt;br&gt;Add label &lt;i&gt;yocto-build&lt;/i&gt; to request a full image build on the PR." vertex="1">
          <mxGeometry height="150" width="330" x="540" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-21" parent="flow-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;⑤ Review, approve, merge to main&lt;/b&gt;&lt;br&gt;All required checks green.&lt;br&gt;Merge commit = the SHA that may later be released." vertex="1">
          <mxGeometry height="150" width="330" x="920" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-31" parent="flow-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;⑫ Dispatch release-candidate.yml&lt;/b&gt;&lt;br&gt;inputs: version (semver) + full 40-char source_commit already on main.&lt;br&gt;concurrency group firmware-release-candidate." vertex="1">
          <mxGeometry height="150" width="330" x="2040" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-38" parent="flow-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;b&gt;⑲ Dispatch promote-mender.yml&lt;/b&gt;&lt;br&gt;candidate_uri · expected_sha256 · artifact_name · canary_device_ids&lt;br&gt;approval on &lt;b&gt;firmware-production&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="330" x="3190" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-3" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" value="GitHub&lt;br&gt;(repo + Actions)" vertex="1">
          <mxGeometry height="200" width="4820" x="20" y="340" as="geometry" />
        </mxCell>
        <mxCell id="flow-19" parent="flow-3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#666666;strokeWidth=2;" value="&lt;b&gt;③ PR checks — pull-request.yml / docs.yml&lt;/b&gt;&lt;br&gt;ubuntu-latest runners:&lt;br&gt;• application: make app-test, app-build&lt;br&gt;• repository: docs-check, python-check, yaml-check, shell-check" vertex="1">
          <mxGeometry height="160" width="330" x="540" y="20" as="geometry" />
        </mxCell>
        <mxCell id="flow-22" parent="flow-3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#666666;strokeWidth=2;" value="&lt;b&gt;⑥ push to main → ci.yml&lt;/b&gt; (Yocto CI Pipeline)&lt;br&gt;concurrency per ref; job queued for self-hosted runner.&lt;br&gt;Also: nightly.yml 02:00 UTC (rm build/tmp, full rebuild, cache refresh)." vertex="1">
          <mxGeometry height="160" width="330" x="920" y="20" as="geometry" />
        </mxCell>
        <mxCell id="flow-35" parent="flow-3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#666666;strokeWidth=2;" value="&lt;b&gt;⑯ Environment gate: firmware-signing&lt;/b&gt;&lt;br&gt;required reviewers approve before the signing job may start." vertex="1">
          <mxGeometry height="120" width="330" x="2800" y="40" as="geometry" />
        </mxCell>
        <mxCell id="flow-4" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" value="Self-hosted runner&lt;br&gt;+ yocto-builder&lt;br&gt;(Ubuntu 24 host)" vertex="1">
          <mxGeometry height="230" width="4820" x="20" y="540" as="geometry" />
        </mxCell>
        <mxCell id="flow-20" parent="flow-4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;④ Optional PR Yocto build&lt;/b&gt; (label yocto-build)&lt;br&gt;runner [self-hosted, linux, yocto]&lt;br&gt;KAS_FILE=kas/ci.yml IMAGE=sensornode-image-ci&lt;br&gt;build-image.sh + run-qemu-tests.sh&lt;br&gt;per-PR cache /srv/yocto-pr-cache/&amp;lt;PR&amp;gt;; no cache push" vertex="1">
          <mxGeometry height="170" width="330" x="540" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-23" parent="flow-4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;⑦ Prepare workspace&lt;/b&gt;&lt;br&gt;instant move of old workspace to trash (background rm, nice/ionice)&lt;br&gt;actions/checkout (submodules)&lt;br&gt;make docs-check yaml-check (fast fail)&lt;br&gt;curl MinIO /minio/health/live" vertex="1">
          <mxGeometry height="170" width="330" x="920" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-24" parent="flow-4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;⑧ scripts/build-image.sh&lt;/b&gt;&lt;br&gt;prepare-build.sh → docker run stonetusker/yocto-builder&lt;br&gt;kas build --target sensornode-image-ci&lt;br&gt;kas/ci.yml (base + mender) : kas/source-lock.yml&lt;br&gt;qemuarm64 · scarthgap · version 0.3.0-&amp;lt;run#&amp;gt;-&amp;lt;sha&amp;gt;" vertex="1">
          <mxGeometry height="170" width="330" x="1280" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-26" parent="flow-4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;⑩ Collect outputs&lt;/b&gt;&lt;br&gt;collect-build-outputs.sh → artifacts/deploy/&lt;br&gt;collect-build-metadata.sh, build-duration-seconds&lt;br&gt;upload-artifact: sensornode-build-outputs" vertex="1">
          <mxGeometry height="170" width="330" x="1640" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-32" parent="flow-4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;⑬ build-test job&lt;/b&gt; [self-hosted, linux, yocto]&lt;br&gt;validate inputs · git merge-base --is-ancestor commit origin/main&lt;br&gt;validate_source_lock.py --require-mender&lt;br&gt;build kas/release.yml → sensornode-image-release (+ create-spdx)" vertex="1">
          <mxGeometry height="170" width="330" x="2040" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-33" parent="flow-4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;⑭ Test the exact release rootfs&lt;/b&gt;&lt;br&gt;run-release-qemu-tests.sh (direct QEMU, pytest: health, version, sensor)&lt;br&gt;generate-sbom.sh (SPDX from same build)&lt;br&gt;unsigned-candidate.mender + sha256 → upload-artifact (7 d)" vertex="1">
          <mxGeometry height="170" width="330" x="2400" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-5" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" value="MinIO&lt;br&gt;(cache + evidence)" vertex="1">
          <mxGeometry height="200" width="4820" x="20" y="770" as="geometry" />
        </mxCell>
        <mxCell id="flow-25" parent="flow-5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d6b656;strokeWidth=2;" value="&lt;b&gt;⑨ Cache read during BitBake&lt;/b&gt;&lt;br&gt;SSTATE_MIRRORS → yocto-sstate&lt;br&gt;PREMIRRORS → yocto-downloads&lt;br&gt;http://host.docker.internal:9000 (miss → upstream fetch)&lt;br&gt;warm build ≈ 2–4 min vs hours cold" vertex="1">
          <mxGeometry height="150" width="330" x="1280" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-27" parent="flow-5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d6b656;strokeWidth=2;" value="&lt;b&gt;⑪ cache-sync.sh push&lt;/b&gt; (main only)&lt;br&gt;mc mirror cache/downloads → yocto-downloads&lt;br&gt;mc mirror cache/sstate → yocto-sstate&lt;br&gt;guarded by CACHE_WRITE_ALLOWED=1; PR builds never write" vertex="1">
          <mxGeometry height="150" width="330" x="1640" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-34" parent="flow-5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d6b656;strokeWidth=2;" value="&lt;b&gt;⑮ Release sstate pushed&lt;/b&gt;&lt;br&gt;cache-sync.sh push (when MinIO write creds set)" vertex="1">
          <mxGeometry height="110" width="330" x="2400" y="45" as="geometry" />
        </mxCell>
        <mxCell id="flow-37" parent="flow-5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;strokeColor=#d6b656;strokeWidth=2;" value="&lt;b&gt;⑱ publish_candidate.py&lt;/b&gt;&lt;br&gt;minio://release-evidence/&amp;lt;ver&amp;gt;/&amp;lt;sha&amp;gt;/&lt;br&gt;signed .mender · sha256 · manifest · sbom/ · release-qemu/&lt;br&gt;fails if namespace exists (immutable)" vertex="1">
          <mxGeometry height="150" width="330" x="2800" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-6" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" value="Jenkins&lt;br&gt;(parallel diagnostic&lt;br&gt;path)" vertex="1">
          <mxGeometry height="200" width="4820" x="20" y="970" as="geometry" />
        </mxCell>
        <mxCell id="flow-28" parent="flow-6" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" value="&lt;b&gt;J1 · sensornode-diagnostic-build&lt;/b&gt;&lt;br&gt;manual / scheduled on agent ubuntu24 (yocto-vps8)&lt;br&gt;Checkout SOURCE_COMMIT → Validate (docs, app, python, shell)" vertex="1">
          <mxGeometry height="150" width="330" x="920" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-29" parent="flow-6" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" value="&lt;b&gt;J2 · Build + QEMU test&lt;/b&gt;&lt;br&gt;same scripts: build-image.sh, run-qemu-tests.sh&lt;br&gt;bitbake -c testimage (oeqa: ping, ssh, systemd, SensorNodeRuntimeTest) → JUnit&lt;br&gt;FAILURE_DRILL → sensornode-image-broken" vertex="1">
          <mxGeometry height="150" width="330" x="1280" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-30" parent="flow-6" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" value="&lt;b&gt;J3 · Diagnostic evidence&lt;/b&gt;&lt;br&gt;create-diagnostic-bundle.sh (logs redacted), JUnit, archive.&lt;br&gt;On failure: (roadmap) Claude via MCP proposes fix → human approves one rebuild.&lt;br&gt;&lt;b&gt;Jenkins cannot promote to Mender.&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="330" x="1640" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-7" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" value="Protected release&lt;br&gt;runner (signing /&lt;br&gt;production env)" vertex="1">
          <mxGeometry height="200" width="4820" x="20" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="flow-36" parent="flow-7" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;dashed=1;dashPattern=6 4;strokeColor=#9673a6;strokeWidth=2;" value="&lt;b&gt;⑰ sign-publish job&lt;/b&gt; [self-hosted, linux, release]&lt;br&gt;download unsigned artifact · build isolated publish set&lt;br&gt;sign-artifact.sh (mender-artifact sign, key 0600) · recompute sha256" vertex="1">
          <mxGeometry height="150" width="330" x="2800" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-39" parent="flow-7" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#9673a6;strokeWidth=2;" value="&lt;b&gt;⑳ promote job&lt;/b&gt;&lt;br&gt;fetch_candidate.py (verify SHA-256)&lt;br&gt;upload-mender-artifact.sh → management API&lt;br&gt;create-mender-deployment.sh → &lt;b&gt;canary only&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="330" x="3190" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-8" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" value="Mender server&lt;br&gt;(docker.mender.io)" vertex="1">
          <mxGeometry height="200" width="4820" x="20" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="flow-40" parent="flow-8" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d79b00;strokeWidth=2;" value="&lt;b&gt;㉑ Artifact + deployment in Mender&lt;/b&gt;&lt;br&gt;deployments service stores artifact (S3);&lt;br&gt;Release sensornode-&amp;lt;ver&amp;gt;-&amp;lt;build&amp;gt;-&amp;lt;sha&amp;gt;;&lt;br&gt;deployment targets canary device IDs" vertex="1">
          <mxGeometry height="150" width="330" x="3190" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-41" parent="flow-8" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#666666;strokeWidth=2;" value="&lt;b&gt;Demo path today&lt;/b&gt;: mender/demo-scenarios/run-ota-e2e.sh&lt;br&gt;logs in (useradm), accepts device auth set,&lt;br&gt;uploads 102 (good) / 103-broken .mender, creates deployments,&lt;br&gt;waits for status, saves evidence to artifacts/ota/&amp;lt;run&amp;gt;/" vertex="1">
          <mxGeometry height="150" width="330" x="3560" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-47" parent="flow-8" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#d79b00;strokeWidth=2;" value="&lt;b&gt;㉖ Deployment result&lt;/b&gt;&lt;br&gt;success → separate decision to widen&lt;br&gt;canary → pilot → fleet (roadmap)&lt;br&gt;failure → stop rollout, keep evidence" vertex="1">
          <mxGeometry height="150" width="330" x="4330" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-48" parent="flow-8" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#666666;strokeWidth=2;" value="&lt;b&gt;㉗ Evidence&lt;/b&gt;&lt;br&gt;artifacts/ota/&amp;lt;run&amp;gt;/summary.json, API responses, device logs, serial.log, SHA256SUMS → docs/15-evidence" vertex="1">
          <mxGeometry height="150" width="330" x="3940" y="25" as="geometry" />
        </mxCell>
        <mxCell id="flow-9" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=150;fillColor=#b1ddf0;strokeColor=#10739e;swimlaneFillColor=#ffffff;fontSize=13;fontStyle=1;container=1;collapsible=0;" value="QEMU device&lt;br&gt;sensornode-canary-01" vertex="1">
          <mxGeometry height="370" width="4820" x="20" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="flow-42" parent="flow-9" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#10739e;strokeWidth=2;" value="&lt;b&gt;㉒ Device picks up deployment&lt;/b&gt;&lt;br&gt;mender client polls https://docker.mender.io&lt;br&gt;(QEMU slirp 10.0.2.2 → host :443)&lt;br&gt;download → verify (ArtifactVerifyKey: roadmap)&lt;br&gt;write image to &lt;b&gt;inactive rootfs B&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="330" x="3580" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-43" parent="flow-9" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#10739e;strokeWidth=2;" value="&lt;b&gt;㉓ Switch + reboot&lt;/b&gt;&lt;br&gt;mark B as next boot (GRUB env)&lt;br&gt;reboot: UEFI → GRUB → kernel → systemd on B&lt;br&gt;sensornode.service starts" vertex="1">
          <mxGeometry height="150" width="330" x="3940" y="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-44" parent="flow-9" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" value="&lt;b&gt;㉔ Health gate&lt;/b&gt;&lt;br&gt;ArtifactCommit_Enter_50&lt;br&gt;_sensornode-health&lt;br&gt;service active?&lt;br&gt;/health 200?&lt;br&gt;no failed units?" vertex="1">
          <mxGeometry height="180" width="220" x="4310" y="15" as="geometry" />
        </mxCell>
        <mxCell id="flow-45" parent="flow-9" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;㉕a PASS → commit B&lt;/b&gt;&lt;br&gt;B becomes permanent;&lt;br&gt;report success.&lt;br&gt;/version shows new image_version." vertex="1">
          <mxGeometry height="110" width="210" x="4570" y="50" as="geometry" />
        </mxCell>
        <mxCell id="flow-46" parent="flow-9" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=middle;spacing=6;strokeColor=#b85450;strokeWidth=2;" value="&lt;b&gt;㉕b FAIL → rollback&lt;/b&gt;&lt;br&gt;no commit; Mender reboots to rootfs A,&lt;br&gt;reports failure; device keeps serving&lt;br&gt;the last good version." vertex="1">
          <mxGeometry height="110" width="300" x="4270" y="230" as="geometry" />
        </mxCell>
        <mxCell id="flow-10" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;spacing=6;" value="&lt;b&gt;A · Develop&lt;/b&gt;" vertex="1">
