# Copy to config/project.env. Do not commit secrets.
# These defaults support local Ubuntu 24.04 builds.
SENSORNODE_VERSION=0.3.0
KAS_FILE=kas/ci.yml
IMAGE=sensornode-image-ci
BUILD_DIR=build
CACHE_DIR=cache
ARTIFACT_DIR=artifacts
BB_NUMBER_THREADS=8
PARALLEL_MAKE=-j 8
# Optional exact-source overlay generated by tools/lock_sources.py.
SOURCE_LOCK_CONFIG=
# Mender client URL is intentionally invalid until a real server is configured.
MENDER_SERVER_URL=https://mender.example.invalid
